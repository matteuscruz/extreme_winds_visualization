.venv/
__pycache__/
*.pyc
.env
.DS_Store
artifacts/lazy_clusters/

# Dados pesados (a maioria não usada pelo dashboard — exceção abaixo)
dataset/raw/*
dataset/*.joblib
dataset/*.csv
*.nc

# INMET_Stratified.nc (11MB) É usado direto por load_inmet_observed() em
# app.py, pro painel "Observed (INMET)" — precisa estar versionado pro app
# na nuvem ter acesso (só tem o que está no repo Git). ERA5_Stratified.nc
# (371MB) continua ignorado — não é lido em lugar nenhum de app.py hoje.
!dataset/raw/INMET_Stratified.nc

# Grids corrigidos (artifacts/corrected_grid/<versão>/grid_corrected_*.nc,
# ~16MB cada) são lidos por load_corrected_grid() na aba "AI database" —
# precisam estar versionados pro app na nuvem ter acesso, senão cai no
# fallback "No corrected grid data found". O glob ** cobre TODAS as versões
# (v1, v1.1, futuras) — a exceção antiga só pegava v1 e deixava a v1.1 de fora.
!artifacts/corrected_grid/**/*.nc

# Gráficos e relatórios (o app lê só CSV/JSON)
artifacts/**/plots/
artifacts/**/*.pdf

artifacts/lstm_pytorch/
artifacts/mlp_clusters/
